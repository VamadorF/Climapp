{
  "expo": {
    "name": "Clima",
    "slug": "clima",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "scheme": "clima",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vamadorf.clima"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.vamadorf.clima"
    },
    "web": {
      "favicon": "./public/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "eas": {
        "projectId": "REEMPLAZA_CON_TU_PROJECT_ID"
      }
    }
  }
}
